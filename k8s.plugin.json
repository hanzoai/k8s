    {
      "method": "GET",
      "pattern": "/v1/k8s/workloads/replicasets",
      "op": "k8s_workloads_list_replicasets"
    },
    {
      "method": "GET",
      "pattern": "/v1/k8s/workloads/services",
      "op": "k8s_workloads_list_services"
    },
    {
      "method": "GET",
      "pattern": "/v1/k8s/workloads/statefulsets",
      "op": "k8s_workloads_list_statefulsets"
    }
