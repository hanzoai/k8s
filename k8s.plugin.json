      "op": "k8s_clusters_deregister"
    },
    {
      "method": "GET",
      "pattern": "/v1/k8s/clusters/:cluster",
      "op": "k8s_clusters_get"
    },
    {
      "method": "GET",
      "pattern": "/v1/k8s/clusters/:cluster/status",
      "op": "k8s_clusters_status"
    },
