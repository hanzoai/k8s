    "k8s_nodes_volume_stats",
    "k8s_pods_list",
    "k8s_pods_logs",
    "k8s_resources_apply",
    "k8s_resources_delete",
    "k8s_resources_get",
    "k8s_resources_list",
    "k8s_resources_watch",
    "k8s_volumes_ensure_claim",
