{
  "name": "k8s",
  "routes": [
    {
      "method": "POST",
      "pattern": "/v1/k8s/access/can",
      "op": "k8s_access_can"
    },
    {
      "method": "GET",
      "pattern": "/v1/k8s/clusters",
      "op": "k8s_clusters_list"
    },
    {
      "method": "POST",
      "pattern": "/v1/k8s/clusters",
      "op": "k8s_clusters_register"
    },
    {
