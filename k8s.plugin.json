    {
      "method": "GET",
      "pattern": "/v1/k8s/resources",
      "op": "k8s_resources_list"
    },
    {
      "method": "PUT",
      "pattern": "/v1/k8s/resources",
      "op": "k8s_resources_apply"
    },
    {
      "method": "DELETE",
      "pattern": "/v1/k8s/resources/:kind/:namespace/:name",
      "op": "k8s_resources_delete"
    },
    {
      "method": "GET",
      "pattern": "/v1/k8s/resources/:kind/:namespace/:name",
      "op": "k8s_resources_get"
    },
    {
      "method": "GET",
      "pattern": "/v1/k8s/resources/watch",
